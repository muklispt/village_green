SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_NAME=green_village
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

DJANGO_ADMIN_PATH=sample 

EMAIL_BACKEND = django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_PASSWORD = your_email_password
EMAIL_HOST_USER = sample@gmail.com
DEFAULT_FROM_EMAIL = your_default_email_like <sample@gmail.com>
EMAIL_USE_TLS=False 


# Orders (all amounts in the currency below; defaults: free shipping, no extra tax)
ORDER_SHIPPING_FEE=0
ORDER_FREE_SHIPPING_THRESHOLD=0
ORDER_TAX_RATE_PERCENT=0
# ------------------------------------------------------------------ Razorpay
# Razorpay Payment Gateway integration (Test Mode / Production)
# Leave unset or empty to disable online payment (checkout then falls back to COD).
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret
RAZORPAY_CURRENCY=INR
